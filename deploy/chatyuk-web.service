[Unit]
Description=ChatYuk Web (Caddy)
After=network.target

[Service]
User=user
Group=user
ExecStart=/usr/local/bin/caddy run --config /data/workspace/chatyuk-web/deploy/Caddyfile --adapter caddyfile
ExecReload=/usr/local/bin/caddy reload --config /data/workspace/chatyuk-web/deploy/Caddyfile --adapter caddyfile
Restart=always
RestartSec=3
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
